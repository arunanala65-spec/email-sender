# Email Sender — web based
# Kirim email lewat SMTP atau API key provider besar. HTML letter didukung.
# Cara pakai: isi kredensial di halaman web per sekali kirim (tidak disimpan di server).
# Opsional: set di hosting sebagai environment variable agar tidak perlu isi tiap kali.

# Kunci aplikasi: kalau diisi, halaman web minta password ini dulu sebelum bisa kirim.
# Kosongkan = tanpa password (JANGAN untuk URL publik yang dibagikan ke orang lain).
APP_PASSWORD=

# Default pengirim (opsional, bisa diisi juga di halaman web)
DEFAULT_FROM=

# --- SMTP generik (opsional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- AWS SES via API (opsional) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SendGrid (opsional) ---
SENDGRID_API_KEY=

# --- Mailgun (opsional) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us

# --- Mailjet (opsional) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# --- Brevo (opsional) ---
BREVO_API_KEY=

# --- Resend (opsional) ---
RESEND_API_KEY=
